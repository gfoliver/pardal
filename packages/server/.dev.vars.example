# Development secrets, for `npm run server:dev` only. Wrangler reads this file and never deploys it.
# Real values are set with `wrangler secret put` and exist only in Cloudflare.
#
# These are deliberately obvious: anything derived from them (a password hash, a session token, a match
# seed) is valid on this machine and nowhere else, and a value that looked real would eventually be
# copied into production by somebody in a hurry.
SALT_KEY=dev-only-salt-key
PEPPER=dev-only-pepper
TOKEN_KEY=dev-only-token-key
SERVER_SEED=dev-only-server-seed
ENVIRONMENT=development
