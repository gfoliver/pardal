{
  "name": "fut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Football simulation game — isolated deterministic match engine (Brasfoot + Football Manager inspired)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty && tsc -p packages/dataset/tsconfig.data.json && tsc -p tsconfig.tests.json",
    "build": "npm run typecheck && npm run build -w @fut/web",
    "dev": "npm run dev -w @fut/web",
    "dataset:build": "tsx packages/dataset/src/cli.ts build",
    "dataset:enrich": "tsx packages/dataset/src/cli.ts enrich",
    "dataset:ratings": "tsx packages/dataset/src/cli.ts ratings",
      "dataset:rebuild": "tsx packages/dataset/src/cli.ts build --from-raw=packages/dataset/data/brasileirao-serie-a/raw.json,packages/dataset/data/brasileirao-serie-b/raw.json --out=packages/dataset/data --slug=brasileirao --name=Brasileirão --emit-to=packages/web/src/lib/career/datasets",
    "sim": "tsx packages/app-cli/src/main.ts",
    "league": "tsx packages/app-cli/src/leagueMain.ts",
    "gen:league": "tsx packages/app-cli/src/generateLeagueData.ts",
    "measure": "tsx packages/app-cli/src/measure.ts",
    "balance:formations": "tsx packages/app-cli/src/formationBalance.ts",
    "balance:goaltypes": "tsx packages/app-cli/src/goalTypes.ts",
    "balance:matchup": "tsx packages/app-cli/src/whyDominates.ts",
    "balance:roles": "tsx packages/app-cli/src/roleSweep.ts",
    "balance:passprobe": "tsx packages/app-cli/src/passProbe.ts",
    "balance:penalties": "tsx packages/app-cli/src/penaltyProbe.ts",
    "balance:involvement": "tsx packages/app-cli/src/involvement.ts",
    "balance:corners": "tsx packages/app-cli/src/cornerProbe.ts",
    "balance:freekicks": "tsx packages/app-cli/src/freeKickProbe.ts",
    "balance:tenmen": "tsx packages/app-cli/src/tenMen.ts",
    "grid": "tsx packages/app-cli/src/gridDump.ts",
    "conformance": "tsx packages/spatial/scripts/buildConformanceBundle.ts && tsx packages/spatial/scripts/crossRuntime.ts",
    "conformance:golden": "tsx packages/spatial/scripts/genGolden.ts",
    "balance:parity": "tsx packages/app-cli/src/engineParity.ts",
    "engine:version": "tsx packages/protocol/scripts/genEngineVersion.ts",
    "career:market": "tsx packages/app-cli/src/careerMarket.ts",
    "career:progression": "tsx packages/app-cli/src/careerProgression.ts",
    "career:depth": "tsx packages/app-cli/src/squadDepth.ts",
    "career:integrity": "tsx packages/app-cli/src/squadIntegrity.ts",
    "career:economy": "tsx packages/app-cli/src/divisionEconomy.ts",
    "dataset:season": "tsx packages/app-cli/src/datasetSeason.ts",
    "dataset:independence": "tsx packages/app-cli/src/attributeIndependence.ts",
    "dataset:spread": "tsx packages/app-cli/src/ratingSpread.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260731.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.20.1",
    "miniflare": "^4.20260722.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
