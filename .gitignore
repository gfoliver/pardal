node_modules/
dist/
*.tsbuildinfo
coverage/
.DS_Store

# local experiment scratch (not committed)
.scratch/

# Emitted dataset artifacts — regenerable from the two source layers with
# `npm run dataset:rebuild`, so only raw.json and enrichment.json are tracked.
# (The app's own copy under packages/web/.../datasets IS committed; it ships.)
packages/dataset/data/*/league.json
packages/dataset/data/*/world.json
packages/dataset/data/*/manifest.json
packages/dataset/data/*/evidence.json

# conformance bundle: build output, rebuilt by `npm run conformance`
packages/spatial/test/__bundle__/

# Wrangler's local secrets. The committed `.dev.vars.example` is the template.
.dev.vars

# Wrangler's local state: the dev D1 database and its caches, rebuilt by `npm run server:dev`.
.wrangler/
