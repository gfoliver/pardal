{
  // The authoring scripts under `data/`, which the package's main tsconfig cannot include
  // (`rootDir: "src"`, so they are not part of the emitted project). Nothing was checking them, and
  // it showed: `parseKader` gained a fourth parameter and a caller kept passing three. No emit —
  // this exists only so a scraper cannot rot unnoticed.
  //
  // `test/` lives in the root `tsconfig.tests.json`, which covers every package's tests at once.
  //
  // A note that used to sit here claimed the `"prior"` label in `ratingsApply.test.ts` could not be
  // fixed because "manual" was special-cased in `positionShape`. That was wrong — nothing reads the
  // label except `applyRatings`, matching "community". The test was right and the type was missing a
  // member; see `AttributeSource`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "types": ["node"]
  },
  "include": ["data/**/*.ts"],
  "references": [{ "path": "." }]
}
